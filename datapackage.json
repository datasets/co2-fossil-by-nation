{
  "name": "co2-fossil-by-nation",
  "title": "National CO2 emissions from fossil fuels and cement manufacture",
  "sources": [
    {
      "name": "CDIAC at AppState",
      "path": "https://rieee.appstate.edu/wp-content/uploads/2024/07/nation.1751_2020.xlsx",
      "title": "National CO2 emissions from fossil fuels and cement manufacture"
    }
  ],
  "licenses": [
    {
      "name": "ODC-PDDL-1.0",
      "path": "http://opendatacommons.org/licenses/pddl/",
      "title": "Open Data Commons Public Domain Dedication and License v1.0"
    }
  ],
  "views": [
    {
      "name": "top-emitters",
      "title": "CO₂ Emissions: Top 10 Countries (1950–2020)",
      "description": "Fossil fuel and cement CO₂ emissions for the ten highest cumulative emitters since 1950. The US led through the 20th century; China overtook it around 2005 and now emits roughly twice as much annually. USSR figures end in 1991 and are continued by Russia.",
      "resources": ["top-emitters"],
      "specType": "plot",
      "spec": {
        "height": 460,
        "marginLeft": 65,
        "marginRight": 20,
        "x": { "label": "Year", "tickFormat": ".0f" },
        "y": { "label": "CO₂ Emissions (Mt)", "grid": true },
        "color": { "legend": true },
        "marks": [
          {
            "type": "ruleX",
            "staticData": [{ "x": 1997 }],
            "x": "x", "stroke": "#9ca3af", "strokeDasharray": "4,4", "tip": false
          },
          {
            "type": "ruleX",
            "staticData": [{ "x": 2015 }],
            "x": "x", "stroke": "#9ca3af", "strokeDasharray": "4,4", "tip": false
          },
          {
            "type": "text",
            "staticData": [{ "x": 1997, "y": 3200, "label": "Kyoto Protocol" }],
            "x": "x", "y": "y", "text": "label",
            "fill": "#6b7280", "fontSize": 11, "textAnchor": "start", "dx": 6
          },
          {
            "type": "text",
            "staticData": [{ "x": 2015, "y": 3200, "label": "Paris Agreement" }],
            "x": "x", "y": "y", "text": "label",
            "fill": "#6b7280", "fontSize": 11, "textAnchor": "start", "dx": 6
          },
          {
            "type": "line",
            "x": "year", "y": "total_mt", "stroke": "country",
            "strokeWidth": 2, "tip": true
          }
        ]
      }
    }
  ],
  "resources": [
    {
      "name": "top-emitters",
      "path": "data/top-emitters.csv",
      "format": "csv",
      "mediatype": "text/csv",
      "schema": {
        "fields": [
          { "name": "country", "type": "string" },
          { "name": "year", "type": "integer" },
          { "name": "total_mt", "type": "number", "description": "CO₂ emissions in megatonnes" }
        ]
      }
    },
    {
      "name": "fossil-fuel-co2-emissions-by-nation",
      "path": "data/fossil-fuel-co2-emissions-by-nation.csv",
      "schema": {
        "fields": [
          {
            "name": "Year",
            "description": "Year",
            "type": "year"
          },
          {
            "name": "Country",
            "description": "Nation",
            "type": "string"
          },
          {
            "name": "Total",
            "description": "Total carbon emissions from fossil fuel consumption and cement production (million metric tons of C)",
            "type": "number"
          },
          {
            "name": "Solid Fuel",
            "description": "Carbon emissions from solid fuel consumption",
            "type": "number"
          },
          {
            "name": "Liquid Fuel",
            "description": "Carbon emissions from liquid fuel consumption",
            "type": "number"
          },
          {
            "name": "Gas Fuel",
            "description": "Carbon emissions from gas fuel consumption",
            "type": "number"
          },
          {
            "name": "Cement",
            "description": "Carbon emissions from cement production",
            "type": "number"
          },
          {
            "name": "Gas Flaring",
            "description": "Carbon emissions from gas flaring",
            "type": "number"
          },
          {
            "name": "Per Capita",
            "description": "Per capita carbon emissions (metric tons of carbon; after 1949 only)",
            "type": "number"
          },
          {
            "name": "Bunker fuels (Not in Total)",
            "description": "Carbon emissions from bunker fuels (not included in total)",
            "type": "number"
          }
        ]
      }
    }
  ],
  "collection": "climate-change"
}